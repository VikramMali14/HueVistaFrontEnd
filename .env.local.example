# Copy this file to `.env.local` (Next.js loads it automatically) and adjust if needed.

# Offline demo mode: 1 = run the frontend with NO backend (built-in demo accounts
# + fixtures; see DEMO.md). Leave unset/0 to use a real backend below.
NEXT_PUBLIC_DEMO_MODE=0

# Base URL of the HueVista backend (Spring Boot). The browser never calls this
# directly — authenticated requests go through the same-origin BFF (/bff/*).
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080

# Server-to-server origin used by Next server actions + the BFF route.
API_INTERNAL_ORIGIN=http://localhost:8080

# Sign in with a mobile number (Firebase Phone Auth). Blank = the option is hidden.
# See .env.example for the full setup notes and what it costs.
#
# Add `localhost` to the Firebase project's authorised domains, and set up
# Authentication → Settings → test phone numbers before you start: every real code is
# a billed SMS (~₹6 in India), so a development loop on a live number adds up fast.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
