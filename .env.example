# Base URL of the HueVista backend (Spring Boot)
# In development this is your local backend; in production point at the public API.
# The browser never talks here directly: all authenticated requests go through
# the same-origin BFF route (/bff/*) which attaches the access token server-side.
#
# It must also be set AT BUILD TIME, not only at run time: the CSP is derived from
# it and `next build` bakes the headers into the image (see the Dockerfile's
# build args). Defaults are per-environment — http://localhost:8080 in dev,
# https://api.huevista.org in a production build — so an unset variable no longer
# ships a policy that blocks every image the API serves.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080

# Used by Next.js server actions and the BFF route when calling the backend.
# Usually identical to NEXT_PUBLIC_API_ORIGIN unless you proxy internally (e.g.
# a private cluster-local URL for server-to-server calls).
API_INTERNAL_ORIGIN=http://localhost:8080

# Public origin this site is served from, no trailing slash. Drives metadataBase
# (so canonical URLs and the Open Graph/WhatsApp link previews resolve), robots.txt,
# sitemap.xml, and the "enter your code at …/redeem" instruction shown to customers
# after a kiosk payment. Defaults to https://app.huevista.org — set it on a preview
# deployment so that deployment's canonicals point at itself, not at production.
NEXT_PUBLIC_SITE_ORIGIN=https://app.huevista.org

# Secret used to sign session cookies (32+ random chars).
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# AWS region the backend's S3 bucket lives in. Used to allow
# `https://*.s3.<region>.amazonaws.com` in the CSP img-src so the browser can
# load presigned image URLs returned by the backend. Must match the backend's
# `app.s3.region`. Defaults to `ap-south-1`.
#
# It must be set AT BUILD TIME (the CSP is baked into the image) and it is read
# again at RUN time by /api/media — see the Dockerfile.
S3_REGION=ap-south-1

# Optional. Pins the ONE bucket `/api/media` — the same-origin image passthrough
# the canvas falls back to when S3 refuses a `crossOrigin="anonymous"` load — is
# allowed to fetch from.
#
# Leave it blank and the server asks the API instead (`GET /api/images/storage`,
# cached), which is the better answer: the API already knows which bucket it
# presigns from, and a value that has to be copied into a second deployment to
# work is a value that will be missing from one of them. It was: unset here, the
# route answered 503 for every image and "Download as PDF" failed on pictures the
# customer could plainly see.
#
# Set it only to override that lookup — a bucket the API does not report, or a
# deployment where this container cannot reach the API. It must name the bucket
# itself, not a URL, and it must match the backend's S3_BUCKET_NAME.
S3_BUCKET_NAME=

# Optional: comma-separated list of extra image hosts allowed by the CSP img-src
# (e.g. a CDN, or a bucket in a non-default region). The backend host and the
# S3 wildcard for `S3_REGION` are already allowed.
IMAGE_REMOTE_HOSTS=

# Public URL of the Android APK. When set, phone-width screens get a "HueVista
# for Android" bar at the bottom and a "Get the Android app" entry in the mobile
# menu; both link straight here. Leave it BLANK (the default) until a build is
# actually published — nothing is offered rather than offering a download that
# 404s. Any public URL works: a GitHub release asset, an S3 object, or a file
# served from this app's own /public.
NEXT_PUBLIC_APK_URL=

# Optional version label shown beside the download, e.g. 0.1.0 renders "APK · v0.1.0".
# Blank falls back to "Direct APK download".
NEXT_PUBLIC_APK_VERSION=

# --- Sign in with a mobile number (Firebase Phone Auth) ----------------------
# Leave these blank and the feature is simply OFF: the mobile option is not offered
# on the sign-in page at all, and /sign-in/phone says so rather than showing a button
# that cannot work.
#
# Why Firebase: texting a one-time code to an Indian mobile needs a DLT sender and
# template registration with TRAI, which we don't hold — so the backend's own SMS
# sender delivers nothing. Firebase sends the code on Google's own registered routes.
# No DLT, no SMS gateway account.
#
# NONE OF THESE IS A SECRET. A Firebase web API key identifies a project; it does not
# authorise anything, and it is designed to ship in the browser bundle — which is why
# they are all NEXT_PUBLIC_. What actually guards the project is the authorised-domains
# list in the Firebase console, plus the backend's FIREBASE_PROJECT_ID check, which
# refuses any token minted by a different Firebase project.
#
# They must be set AT BUILD TIME (NEXT_PUBLIC_* is inlined into the bundle), and
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN must ALSO be set at RUN time because next.config.ts
# builds the CSP from it at server start — the same trap documented for the API origin
# above. The Dockerfile carries them through to both stages.
#
# Setting it up (once, ~10 minutes, free tier):
#   1. console.firebase.google.com → create or open the project.
#   2. Build → Authentication → Sign-in method → enable "Phone".
#   3. Authentication → Settings → Authorised domains: add every domain the app is
#      served from (app.huevista.org, and localhost for development). A domain that is
#      missing here fails with auth/unauthorized-domain and nothing else explains it.
#   4. Project settings → Your apps → Web app → copy its config into the four values
#      below, and set the SAME project id as FIREBASE_PROJECT_ID on the backend.
#   5. Optional but recommended: Authentication → Settings → add test phone numbers,
#      so development and CI never spend a real SMS.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional — only used by Firebase Analytics, which this app does not enable. Phone
# sign-in works without it.
NEXT_PUBLIC_FIREBASE_APP_ID=
